# Copy to .env.local for your machine. Never commit real values.
# Mock mode is NEVER active unless BOTH of these are set:
LEXABLE_ENV=development
LEXABLE_DEV_MODE=true

# Required for real authentication once the Lexable backend publishes
# the plugin discovery document. Leave empty until that exists.
# Do not guess or invent this URL.
# LEXABLE_API_BASE_URL=
# LEXABLE_CLIENT_ID=

# Optional override of the discovery path. Default is documented in
# docs/BACKEND-CONTRACT.md and is not a live endpoint today.
# LEXABLE_DISCOVERY_PATH=/.well-known/lexable-plugin.json
